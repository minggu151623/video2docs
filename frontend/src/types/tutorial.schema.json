          "type": "number"
        },
        "end_sec": {
          "minimum": 0,
          "title": "End Sec",
          "type": "number"
        },
        "source": {
          "enum": [
            "visual",
            "audio",
            "both"
          ],
          "title": "Source",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
