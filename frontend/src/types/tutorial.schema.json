          "title": "Basis",
          "type": "string"
        },
        "scope": {
          "default": "clip",
          "enum": [
            "tutorial",
            "clip"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence_spans"
      ],
      "title": "SourceClaim",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
