        "needs_review": {
          "title": "Needs Review",
          "type": "boolean"
        },
        "review_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review Reason"
        }
