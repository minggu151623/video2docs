{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "text": {
          "maxLength": 12000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unclear"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence Spans",
          "type": "array"
        }
      },
      "required": [
        "language",
        "text",
        "completeness",
        "evidence_spans"
      ],
      "title": "Command",
      "type": "object"
    },
    "SourceClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence Spans",
          "type": "array"
        },
        "basis": {
          "default": "unclear",
          "enum": [
            "observed",
            "stated",
            "inferred",
            "unclear"
