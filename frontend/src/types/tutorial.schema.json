        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Evidence Spans",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "evidence_spans"
      ],
      "title": "ToolMention",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "start_sec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
