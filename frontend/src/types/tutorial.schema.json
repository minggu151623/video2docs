        "title",
        "start_sec",
        "end_sec",
        "actions",
        "expected_result",
        "commands",
        "evidence_spans",
        "screenshot_candidates_sec",
        "needs_review",
        "review_reason"
      ],
      "title": "Step",
      "type": "object"
