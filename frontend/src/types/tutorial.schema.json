        },
        "end_sec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Sec"
        }
      },
      "required": [
        "description",
        "start_sec",
        "end_sec"
      ],
      "title": "Uncertainty",
      "type": "object"
